# Copy to .env (never commit .env). Read by the app locally and by docker compose.

# "anthropic" or "local" (Ollama / any OpenAI-compatible server)
LLM_BACKEND=local

# Local backend
LOCAL_LLM_BASE_URL=http://localhost:11434          # in Docker use http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen2.5:7b

# Anthropic backend
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-request LLM timeout in seconds
LLM_TIMEOUT_SECONDS=120

# If set, every API route except /health requires header  X-API-Key: <this value>
API_KEY=

LOG_LEVEL=INFO
